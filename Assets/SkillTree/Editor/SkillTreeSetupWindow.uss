.skill-tree-setup {
    flex-grow: 1;
    padding: 16px;
}

.window-title {
    margin-bottom: 12px;
    font-size: 18px;
    -unity-font-style: bold;
}

.settings-section {
    padding-top: 12px;
    border-top-width: 1px;
    border-top-color: #4b525b;
}

.settings-field {
    flex-grow: 1;
}

.field-host {
    margin-top: 10px;
}

.output-row {
    flex-direction: row;
    align-items: flex-end;
    margin-top: 10px;
}

.output-path-host {
    flex-grow: 1;
    margin-right: 6px;
}

.primary-button {
    min-height: 30px;
    margin-bottom: 4px;
    background-color: #2f6f9f;
    color: #f4f7fa;
    -unity-font-style: bold;
}

.browse-button {
    width: 34px;
    height: 22px;
}

.action-section {
    margin-top: 18px;
    padding-top: 12px;
    border-top-width: 1px;
    border-top-color: #4b525b;
}

.generate-button {
    min-height: 30px;
    background-color: #3d7d55;
    color: #f4f7fa;
    -unity-font-style: bold;
}

.status-label {
    min-height: 18px;
    margin-top: 8px;
    color: #c7cbd1;
    white-space: normal;
}
