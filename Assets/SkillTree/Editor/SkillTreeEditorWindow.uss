.skill-tree-editor {
    flex-grow: 1;
    background-color: #1c1f24;
}

.editor-split {
    flex-grow: 1;
}

.graph-pane {
    flex-grow: 1;
    min-width: 480px;
}

.graph-toolbar {
    height: 32px;
    flex-direction: row;
    align-items: center;
    padding-left: 8px;
    padding-right: 8px;
    background-color: #252a30;
    border-bottom-width: 1px;
    border-bottom-color: #111318;
}

.mode-label {
    min-width: 92px;
    padding: 3px 8px;
    border-radius: 3px;
    color: #f4f7fa;
    -unity-font-style: bold;
}

.mode-move {
    background-color: #286b92;
}

.mode-resize {
    background-color: #9a5d22;
}

.mode-info {
    background-color: #39745b;
}

.mode-key {
    width: 22px;
    height: 20px;
    margin-left: 6px;
    padding-top: 2px;
    -unity-text-align: middle-center;
    background-color: #3a4048;
    border-radius: 3px;
    color: #d7dbe0;
}

.info-mode-button {
    height: 22px;
    margin-left: 8px;
    padding-left: 9px;
    padding-right: 9px;
    background-color: #343a42;
    color: #d7dbe0;
    border-radius: 3px;
}

.info-mode-button.info-mode-button-active {
    background-color: #39745b;
    color: #ffffff;
}

.info-editor-mode .snap-step-control {
    display: none;
}

.snap-step-control {
    height: 22px;
    margin-left: 12px;
    flex-direction: row;
    align-items: center;
}

.snap-step-label {
    width: 70px;
    color: #d7dbe0;
}

.snap-step-input {
    width: 54px;
    height: 20px;
    margin-left: 6px;
}

.graph-host,
.skill-tree-graph {
    flex-grow: 1;
}

.graph-grid {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.base-canvas {
    background-color: #24282e;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #626a74;
    border-right-color: #626a74;
    border-top-color: #626a74;
    border-bottom-color: #626a74;
}

.skill-node {
    padding: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    background-color: transparent;
    overflow: visible;
}

.skill-node.selected {
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: #52a9dc;
    border-right-color: #52a9dc;
    border-top-color: #52a9dc;
    border-bottom-color: #52a9dc;
}

.skill-tree-graph.resize-mode .skill-node.selected {
    border-left-color: #e49a45;
    border-right-color: #e49a45;
    border-top-color: #e49a45;
    border-bottom-color: #e49a45;
}

.skill-node-main {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    background-color: transparent;
    overflow: visible;
}

.skill-node.resize-node-selected {
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: #e49a45;
    border-right-color: #e49a45;
    border-top-color: #e49a45;
    border-bottom-color: #e49a45;
}

.skill-node-visual {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    position: relative;
    background-color: transparent;
    overflow: visible;
}

.node-image {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: transparent;
}

.skill-image {
    position: absolute;
    background-color: transparent;
}

.related-node-outline {
    display: none;
    position: absolute;
    left: 4px;
    right: 4px;
    top: 4px;
    bottom: 4px;
    background-color: transparent;
}

.related-node-outline.related-node-outline-active {
    display: flex;
}

.related-node-corner {
    position: absolute;
    width: 16px;
    height: 16px;
    background-color: transparent;
}

.related-node-top-left {
    left: 0;
    top: 0;
    border-left-width: 3px;
    border-top-width: 3px;
}

.related-node-top-right {
    right: 0;
    top: 0;
    border-right-width: 3px;
    border-top-width: 3px;
}

.related-node-bottom-left {
    left: 0;
    bottom: 0;
    border-left-width: 3px;
    border-bottom-width: 3px;
}

.related-node-bottom-right {
    right: 0;
    bottom: 0;
    border-right-width: 3px;
    border-bottom-width: 3px;
}

.related-node-outline.related-node-child .related-node-corner {
    border-left-color: #399bea;
    border-right-color: #399bea;
    border-top-color: #399bea;
    border-bottom-color: #399bea;
}

.related-node-outline.related-node-parent .related-node-corner {
    border-left-color: #46bd72;
    border-right-color: #46bd72;
    border-top-color: #46bd72;
    border-bottom-color: #46bd72;
}

.resize-handle {
    display: none;
    position: absolute;
    width: 15px;
    height: 15px;
    background-color: transparent;
    border-left-color: #e49a45;
    border-right-color: #e49a45;
    border-top-color: #e49a45;
    border-bottom-color: #e49a45;
}

.resize-handle.resize-handle-active {
    display: flex;
    opacity: 1;
}

.resize-top-left {
    left: 0;
    top: 0;
    border-left-width: 2px;
    border-top-width: 2px;
}

.resize-top-right {
    right: 0;
    top: 0;
    border-right-width: 2px;
    border-top-width: 2px;
}

.resize-bottom-left {
    left: 0;
    bottom: 0;
    border-left-width: 2px;
    border-bottom-width: 2px;
}

.resize-bottom-right {
    right: 0;
    bottom: 0;
    border-right-width: 2px;
    border-bottom-width: 2px;
}

.node-anchor {
    display: none;
    position: absolute;
    width: 14px;
    height: 14px;
    background-color: #5fb7e7;
    border-radius: 0;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: #d9f2ff;
    border-right-color: #d9f2ff;
    border-top-color: #d9f2ff;
    border-bottom-color: #d9f2ff;
}

.node-anchor-active {
    display: flex;
}

.node-anchor:hover {
    background-color: #8bd8ff;
    border-left-color: #ffffff;
    border-right-color: #ffffff;
    border-top-color: #ffffff;
    border-bottom-color: #ffffff;
}

.connection-segment-hit {
    position: absolute;
    background-color: transparent;
}

.connection-segment-highlight {
    display: none;
    position: absolute;
    background-color: #59c6ff;
}

.connection-segment-selected .connection-segment-highlight {
    display: flex;
}

.skill-tree-graph.resize-mode .connection-segment-selected .connection-segment-highlight {
    background-color: #e49a45;
}

.connection-segment-horizontal .connection-segment-highlight {
    left: 0;
    right: 0;
    top: 3px;
    height: 6px;
}

.connection-segment-vertical .connection-segment-highlight {
    left: 3px;
    top: 0;
    bottom: 0;
    width: 6px;
}

.node-info-tooltip {
    position: absolute;
    width: 280px;
    padding: 10px;
    background-color: #171a1f;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #69727d;
    border-right-color: #69727d;
    border-top-color: #69727d;
    border-bottom-color: #69727d;
    border-radius: 4px;
}

.node-info-tooltip.node-info-tooltip-editable {
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: #58b98c;
    border-right-color: #58b98c;
    border-top-color: #58b98c;
    border-bottom-color: #58b98c;
}

.node-info-tooltip-field {
    margin: 0;
}

.node-info-tooltip-field .unity-text-field__input {
    background-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    color: #edf1f5;
}

.node-info-tooltip-title-row {
    flex-direction: row;
    align-items: center;
}

.node-info-tooltip-title {
    flex-grow: 1;
}

.node-info-tooltip-title .unity-text-field__input {
    font-size: 16px;
    -unity-font-style: bold;
}

.node-info-tooltip-state {
    margin-left: 8px;
    color: #7ed9ad;
    -unity-font-style: bold;
}

.node-info-tooltip-description {
    min-height: 62px;
    margin-top: 5px;
}

.node-info-tooltip-description .unity-text-field__input {
    white-space: normal;
}

.node-info-tooltip-price {
    margin-top: 4px;
    color: #e7c36d;
    -unity-text-align: middle-right;
}

.node-info-tooltip-stat-row {
    flex-direction: row;
    margin-top: 7px;
    padding-top: 6px;
    border-top-width: 1px;
    border-top-color: #3c424a;
}

.node-info-tooltip-stat-name {
    flex-grow: 1;
}

.node-info-tooltip-stat-value {
    width: 90px;
}

.node-info-tooltip-stat-value .unity-text-field__input {
    -unity-text-align: middle-right;
    color: #7ed9ad;
}

.inspector-host {
    min-width: 240px;
    background-color: #262a30;
    border-left-width: 1px;
    border-left-color: #111318;
}

.node-inspector {
    flex-grow: 1;
}

.inspector-title {
    height: 32px;
    padding-left: 10px;
    padding-top: 7px;
    background-color: #30353c;
    color: #eef1f4;
    -unity-font-style: bold;
}

.inspector-empty {
    margin: 14px 10px;
    color: #aeb4bc;
    white-space: normal;
}

.inspector-fields {
    flex-grow: 1;
    padding: 8px 10px 14px 10px;
}

.inspector-field {
    margin-bottom: 8px;
}

.effect-list-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 4px;
    margin-bottom: 6px;
    color: #eef1f4;
    -unity-font-style: bold;
}

.effect-add-button {
    width: 26px;
    height: 22px;
}

.effect-item {
    margin-bottom: 8px;
    padding: 7px;
    background-color: #20242a;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #3c424a;
    border-right-color: #3c424a;
    border-top-color: #3c424a;
    border-bottom-color: #3c424a;
    border-radius: 4px;
}

.effect-item-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 5px;
}

.effect-type-field {
    flex-grow: 1;
}

.effect-remove-button {
    margin-left: 6px;
}

.effect-field {
    margin-top: 4px;
}

.effect-warning {
    margin-top: 5px;
    color: #e7c36d;
    white-space: normal;
}

.info-description-field {
    min-height: 110px;
}

.hidden {
    display: none;
}
