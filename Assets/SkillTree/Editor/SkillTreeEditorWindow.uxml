<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="root" class="skill-tree-editor">
        <ui:TwoPaneSplitView name="editorSplit" fixed-pane-index="1" fixed-pane-initial-dimension="330" orientation="Horizontal" class="editor-split">
            <ui:VisualElement class="graph-pane">
                <ui:VisualElement class="graph-toolbar">
                    <ui:Label name="modeLabel" class="mode-label" />
                    <ui:Label text="S" tooltip="이동/크기 변경 모드 전환" class="mode-key" />
                    <ui:Button name="infoModeButton" text="Info Editor" tooltip="Tooltip 정보 편집 모드 (I)" class="info-mode-button" />
                    <ui:VisualElement class="snap-step-control">
                        <ui:Label text="Ctrl 스냅" class="snap-step-label" />
                        <ui:IntegerField name="snapStepField" value="1" class="snap-step-input" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="graphHost" class="graph-host" />
            </ui:VisualElement>
            <ui:VisualElement name="inspectorHost" class="inspector-host" />
        </ui:TwoPaneSplitView>
    </ui:VisualElement>
</ui:UXML>
